PORT=3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre@example.com
SMTP_PASS=votre_cle_api_brevo
BREVO_SMTP_USER=xxxxxxxx@smtp-brevo.com
BREVO_SMTP_PASS=votre_cle_smtp_brevo
ADMIN_EMAIL=admin@example.com
BASE_URL=https://votre-app.onrender.com
COUNTER_SEED=0

# Nombre de proxys de confiance devant l'application : décide de l'adresse IP
# retenue, donc du comptage du limiteur de débit. 1 derrière Render, 0 sans proxy.
TRUST_PROXY=1

# Nombre d'enregistrements gardés dans data/devis.json. Au-delà, les plus
# anciennes demandes dont le traitement est terminé partent dans un fichier
# data/devis.json.archive-<horodatage>, jamais relu.
DEVIS_MAX=1000

# Envois d'emails simultanés : un email = une connexion SMTP vers Brevo.
MAIL_MAX_CONCURRENT=4
MAIL_ATTENTE_MAX_MS=120000
MAIL_MAX_FILE=500
